# Copy this file to .env and replace placeholder values.
# .env is gitignored and must never be committed.
#
# Loaded at startup by DotEnvEnvironmentPostProcessor.
# Required by application.yml: spring.datasource.url/username/password

# --- MariaDB connection (development database) ---
DB_URL=jdbc:mariadb://localhost:3306/researchflow
DB_USER=researchflow
DB_PASSWORD=your_password_here

# --- Optional overrides for automated tests (profile=test) ---
# Defaults target database researchflow_test with the same user unless overridden.
# TEST_DB_URL=jdbc:mariadb://localhost:3306/researchflow_test
# TEST_DB_USER=researchflow
# TEST_DB_PASSWORD=your_password_here

# --- Demo seed accounts (read by DemoDataSeeder on startup) ---
# If any of these are blank, demo seeding is skipped.
# Administrator accounts are seed-only (not available via /register).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
SEED_STUDENT_USERNAME=student1
SEED_STUDENT_PASSWORD=change_me
SEED_FACULTY_USERNAME=faculty1
SEED_FACULTY_PASSWORD=change_me
